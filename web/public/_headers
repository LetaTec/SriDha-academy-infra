# Cloudflare Pages custom headers
# Global security headers for all paths.
# The Content-Security-Policy allows only what the site loads: its own files,
# the API on Render, Google Fonts, and Razorpay's checkout (script, frames,
# images and telemetry) and Sentry error reports. Update it when adding a new
# third-party service.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://checkout.razorpay.com https://*.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.razorpay.com; connect-src 'self' https://sridha-academy-api.onrender.com https://api.sridhaacademy.com https://*.razorpay.com https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://*.ingest.de.sentry.io; frame-src https://api.razorpay.com https://checkout.razorpay.com https://*.razorpay.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests

# HTML documents: must revalidate so clients receive new deployments immediately
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Static Vite hashed assets: safe for long-term immutable caching
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Favicon asset caching
/favicon*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/og-image.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

