# Runtime environment: development | test | production
NODE_ENV=development

# Port the API listens on
PORT=4000

# PostgreSQL connection URL (Required in production)
# In development, if omitted or set to :memory:, an in-memory PostgreSQL instance is used automatically.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sridha_dev

# Primary public origin of the website (Required in production)
WEB_ORIGIN=http://localhost:5173

# Comma-separated list of additional permitted frontend origins (e.g. preview deploys, www subdomain)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Session lifetime in days (default and "remember me")
SESSION_TTL_DAYS=1
SESSION_REMEMBER_TTL_DAYS=30

# Transactional mail delivery:
#   console - logs reset links to console (development/test only; forbidden in production)
#   resend  - sends transactional emails via Resend API (requires RESEND_API_KEY)
#   (unset) - responds with PASSWORD_RECOVERY_UNAVAILABLE
MAIL_TRANSPORT=console

# Resend API key (Required if MAIL_TRANSPORT=resend)
# RESEND_API_KEY=re_your_api_key_here

# Verified sender email address
EMAIL_FROM=SriDha Academy <noreply@sridhaacademy.com>

# Maximum PostgreSQL connection pool size
PG_MAX_CONNECTIONS=10

# Serve the built website (web/dist) directly from Express (disabled when frontend is on Cloudflare Pages)
SERVE_WEB_DIST=false

# Session cookie SameSite policy (lax | none | strict)
# Defaults to "none" in production (with Secure and Partitioned for cross-site support between sridhaacademy.com and onrender.com)
# Set to "lax" once custom domain api.sridhaacademy.com is mapped
COOKIE_SAMESITE=none

# Optional domain attribute for cookies (leave unset for host-only cookies)
# COOKIE_DOMAIN=.sridhaacademy.com

# Comma-separated emails of super admins. They sign in without a password,
# using a one-time link emailed to them (needs MAIL_TRANSPORT). Applied on
# every start: removing an email here removes that account's admin role.
SUPER_ADMIN_EMAILS=samakshmathur25@gmail.com

# Razorpay API keys from the Razorpay dashboard (Settings → API Keys). Set
# both or neither; production refuses to start without them. Without them
# (development) checkout runs in test mode: orders are saved
# as payment pending and nothing is charged or confirmed.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=

# Webhook secret you choose in Razorpay (Settings → Webhooks) for
# https://<api host>/api/payments/webhook with the payment.captured and
# order.paid events. Confirms seats even if the student closes the page.
# Required in production, like the API keys above.
# RAZORPAY_WEBHOOK_SECRET=

# Log level: debug | info | warn | error | silent (default info; tests are
# silent). Production logs one JSON object per line, each request with its
# X-Request-Id.
# LOG_LEVEL=info

# Sentry project DSN (sentry.io → Project settings → Client keys). When set,
# every error the API logs is reported there, without student data. Leave
# unset to send nothing.
# SENTRY_DSN=
